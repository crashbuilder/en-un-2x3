# Configuración de Base de Datos PostgreSQL (Compartida con Fonsi Core)
DB_HOST=127.0.0.1
DB_PORT=5435
DB_USER=fonsi_user
DB_PASSWORD=fonsi_password
DB_NAME=en_un_2x3

# Redis para sesiones y caché en vivo
REDIS_URL=redis://127.0.0.1:6379

# Configuración de IA (Gemini 2.5 Flash)
LLM_API_KEY=tu_api_key_de_gemini_aqui
LLM_MODEL=gemini-2.5-flash

# Administradores en WhatsApp (Números con código de país sin +, separados por coma)
ADMIN_WHATSAPP_NUMBERS=573506811888

# Puerto de estado y visor QR web
PORT=3005

# Ruta al workspace compartido de reglas y herramientas
WORKSPACE_PATH=/root/en-un-2x3/workspace-fonsi
